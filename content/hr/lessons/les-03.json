      "gen_sg": "veljače",
      "ua": "лютий",
      "audio": "hr-veljaca.mp3",
      "forms": [
        "veljače",
        "veljači"
      ],
      "explain_ua": "(Prijatelj je u gradu u veljači = друг у місті в лютому). Єдиний місяць жіночого роду. Пиши č, не ć: veljača, не «veljaća». Родовий veljače, місцевий u veljači (-a стає -i). У множині не вживається"
    },
