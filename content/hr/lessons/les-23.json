    {
      "id": "hr-bad011c3",
      "type": "noun",
      "lemma": "trbuh",
      "gender": "m.",
      "gen_sg": "trbuha",
      "plural": [
        "trbusi"
      ],
      "ua": "живіт",
      "audio": "hr-trbuh.mp3",
      "forms": [
        "trbuha"
      ],
      "explain_ua": "(Boli me trbuh = болить живіт). Trbuh це живіт, а život це життя: ми вчили цю пастку (укр. живіт = хорв. trbuh). Множину trbusi (h > s) використовують рідко",
      "check": "Значення trbuh, і форми trbuha, trbusi з мого знання, у джерелах цього уроку не підтверджено; множину краще перевірити в словнику."
    },
    {
      "id": "hr-618daedc",
      "type": "verb",
      "lemma": "boljeti",
      "aspect": "impf.",
      "pres_1sg": "bolim",
      "forms": [
        "boli"
      ],
      "ua": "боліти",
      "audio": "hr-boljeti.mp3",
      "explain_ua": "(Boli me glava = болить голова). Тут майже завжди 3 особа: boli. Той, у кого болить, стоїть у знахідному: me (мене), te (тебе): Boli me glava. Українське «болить голова» має іншу конструкцію: «у мене болить голова»",
      "check": "Форма bolim з мого знання (вживається рідко); boli me підтверджено в підручнику."
    },
    {
      "id": "hr-8874c7be",
      "type": "verb",
      "lemma": "uzimati",
      "aspect": "impf.",
      "partner": "uzeti",
      "pres_1sg": "uzimam",
      "forms": [
        "uzeti",
        "uzmem",
        "uzmeš",
        "uzme",
        "uzimam"
      ],
      "ua": "брати, приймати (док. uzeti)",
      "audio": "hr-uzimati.mp3",
      "explain_ua": "(Uzmite lijek = візьміть ліки). Пара: uzimati (недок., uzimam) / uzeti (док., uzmem). Укр. «брати, взяти»: корінь не той, а uz- вживається як «взяти». Для ліків часто uzimati redovito, uzeti одноразово",
      "check": "Пара uzimati / uzeti і форми з мого знання, у джерелах цього уроку не підтверджено."
    },
    {
      "id": "hr-9d282cf3",
      "type": "verb",
      "lemma": "smjeti",
      "aspect": "impf.",
      "pres_1sg": "smijem",
      "forms": [
        "smijem"
      ],
      "ua": "сміти, мати дозвіл",
      "audio": "hr-smjeti.mp3",
      "explain_ua": "(Smijem li ići kući? = можна мені йти додому?). Smjeti означає «мати дозвіл»: smijem. Хорватське smijem li ближче до «можна мені?», ніж до «сміти». Відрізняється від moći (мати змогу)",
      "check": "Smijem підтверджено в підручнику; вживання smijem li як питання про дозвіл з мого знання."
    },
    {
      "id": "hr-31704f99",
      "type": "function",
      "lemma": "nemoj",
      "ua": "не роби! (заперечний наказ + інфінітив)",
      "audio": "hr-nemoj.mp3",
      "forms": [
        "nemojte",
        "nemojmo"
      ],
      "explain_ua": "(Nemoj čekati! = не чекай!). Nemoj, nemojmo, nemojte + інфінітив: підручник (с. 121). Це найбезпечніший заперечний наказ: Nemojte čekati ovdje. Ne + наказ (Ne čekaj!) теж у підручнику (с. 120), але див. правило",
      "check": "Форми nemoj, nemojmo, nemojte + інфінітив підтверджено в підручнику (с. 121); яка форма частіша у побуті, з мого знання."
    },
    {
      "id": "hr-92287720",
      "type": "function",
      "lemma": "neka",
      "ua": "нехай (3 особа: neka + теперішній)",
      "audio": "hr-neka.mp3",
      "forms": [
        "čeka",
        "radi",
        "uzme"
      ],
      "explain_ua": "(Neka čeka ovdje = нехай чекає тут). Для 3 особи наказ це neka + теперішній: Neka radi! Neka rade! (с. 120). Українське нехай чекає: збігається майже дослівно",
      "check": "Neka + теперішній підтверджено в підручнику (с. 120)."
    },
