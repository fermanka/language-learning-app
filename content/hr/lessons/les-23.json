  "rule": [
    {
      "title_ua": "Наказ: ти і ви",
      "summary_ua": "Наказ в хорватській має окремі форми для ти, ми і ви: plati, platimo, platite; pitaj, pitajmo, pitajte (підручник, с. 120). Закінчення -i / -imo / -ite або -j / -jmo / -jte, залежно від основи. Лікареві, незнайомій людині, старшим кажуть форму на -te (ви). Українська тут допомагає: -іть (чекайте), -и (чекай), тож закінчення -te і -ite близькі до «-іть».",
      "compare": [
        {
          "form": "-i / -ite: plati, uzmi, dođi",
          "when_ua": "Коли основа теперішнього закінчується на приголосний: plati, platite; uzmi, uzmite.",
          "examples": [
            {
              "text": "Uzmite tabletu.",
              "ua": "Візьміть таблетку.",
              "audio": "hr-les23-rule-01.mp3"
