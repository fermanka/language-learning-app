  "rule": [
    {
      "title_ua": "Прикметник у множині: nove cipele, toplih čarapa",
      "summary_ua": "Прикметник узгоджується з іменником у роді, числі й відмінку. У множині: називний і знахідний nove cipele (жін.), novi šeširi (чол.); родовий -ih: toplih čarapa; давальний, місцевий, орудний -im(a): u novim cipelama. Закінчення -ih і -im схожі на українські -их і -им, тож тут допомагає українська.",
      "compare": [
        {
          "form": "називний і знахідний множини: -e (жін.), -i (чол.), -a (сер.)",
          "when_ua": "nove cipele, tople čarape; novi šeširi.",
          "examples": [
            {
              "text": "Imam nove cipele.",
              "ua": "Маю нові черевики.",
              "audio": "hr-les25-rule-01.mp3"
            },
            {
              "text": "Imam tople čarape.",
              "ua": "Маю теплі шкарпетки.",
              "audio": "hr-les25-rule-02.mp3"
            },
            {
              "text": "Volim tople čizme.",
              "ua": "Люблю теплі чоботи.",
              "audio": "hr-les25-rule-03.mp3"
            }
          ],
          "note_ua": "Жіночий -e, не -i, як у чоловічому. Українська -і в усіх родах множини, тому тут є різниця."
        },
        {
          "form": "родовий -ih; D/L/I -im(a)",
          "when_ua": "nemam toplih čarapa; u novim cipelama.",
          "examples": [
            {
              "text": "Nemam toplih čarapa.",
              "ua": "Не маю теплих шкарпеток.",
              "audio": "hr-les25-rule-04.mp3"
            },
            {
              "text": "Nemam novih cipela.",
              "ua": "Не маю нових черевиків.",
              "audio": "hr-les25-rule-05.mp3"
            },
            {
              "text": "Marija je u novim cipelama.",
              "ua": "Марія в нових черевиках.",
              "audio": "hr-les25-rule-06.mp3"
            }
          ],
          "note_ua": "Тут допомагає українська: -их = -ih, -им = -im."
        }
      ],
      "points_ua": [
        "Називний множини: nove (ж.), novi (ч.), nova (с.).",
        "Родовий: -ih. Давальний, місцевий, орудний: -im(a).",
        "Іменник у родовому множини теж змінюється: čarapa, cipela."
      ]
    },
    {
      "title_ua": "Nov і novi: невизначений і означений",
      "summary_ua": "Чоловічий прикметник має дві форми: невизначену (nov) і означену (novi). Imam nov šešir = «маю новий (якийсь) капелюх». Novi šešir je skup = «той новий капелюх дорогий». Ні українська, ні російська цього не роблять, тож нічого не переноситься: на B1 головне розпізнавати.",
      "compare": [
        {
          "form": "nov / novi",
          "when_ua": "Nov: нова інформація, прикметник після biti: Kaput je nov. Novi: відомий предмет, перед іменником.",
          "examples": [
            {
              "text": "Imam nov šešir.",
              "ua": "Маю новий капелюх.",
              "audio": "hr-les25-rule-07.mp3"
            },
            {
              "text": "Novi kaput je skup.",
              "ua": "Те нове пальто дороге.",
              "audio": "hr-les25-rule-08.mp3"
            },
            {
              "text": "Moj kaput je nov.",
              "ua": "Моє пальто нове.",
              "audio": "hr-les25-rule-09.mp3"
            }
          ],
          "note_ua": "Тут нічого не допомагає: нічого схожого в українській нема. Жіночий і середній рід такої пари не мають."
        }
      ],
      "points_ua": [
        "Лише чоловічий рід: nov / novi.",
        "Після biti часто невизначена форма: kaput je nov.",
        "На B1 це більше розпізнавання, ніж продукція."
      ]
    },
    {
      "title_ua": "Vrijeme: час і погода",
      "summary_ua": "Vrijeme значить і «час», і «погода». Це полісемія, а не хибний друг. Погоду описують: Kakvo je vrijeme? Pada kiša. Pada snijeg. Danas je hladno. Ljeti je toplo. Українське дощ іде, сніг іде: тут «падає», як у російській «идёт».",
      "compare": [
        {
          "form": "pada kiša / snijeg; je hladno / toplo",
          "when_ua": "Дощ і сніг: pada. Температура: je hladno / toplo (середній рід).",
          "examples": [
            {
              "text": "Danas pada kiša.",
              "ua": "Сьогодні іде дощ.",
              "audio": "hr-les25-rule-10.mp3"
            },
            {
              "text": "Danas je hladno.",
              "ua": "Сьогодні холодно.",
              "audio": "hr-les25-rule-11.mp3"
            },
            {
              "text": "Vrijeme je lijepo.",
              "ua": "Погода гарна.",
              "audio": "hr-les25-rule-12.mp3"
            }
          ],
          "note_ua": "Не тільки погода: Nemam vremena = немає часу."
        }
      ],
      "points_ua": [
        "Pada kiša, pada snijeg.",
        "Je hladno, je toplo: середній рід.",
        "Vrijeme: і час, і погода."
