  "rule": [
    {
      "title_ua": "Koji: який, яка, яке в називному",
      "summary_ua": "Koji пов'язує дві частини: Ovo je moj šef koji radi u uredu. Рід і число koji беремо з іменника, на який воно вказує (šef > koji, kolegica > koja). Це точно як в українській: який, яка, яке. Перед koji кома.",
      "compare": [
        {
          "form": "koji (чол.), koja (жін.), koje (сер.)",
          "when_ua": "Koji підмет підрядного речення: šef koji radi; kolegica koja radi.",
          "examples": [
            {
              "text": "Ovo je moj šef koji radi u uredu.",
              "ua": "Це мій начальник, який працює в офісі.",
              "audio": "hr-les26-rule-01.mp3"
            },
            {
              "text": "Ovo je moja kolegica koja radi u uredu.",
              "ua": "Це моя колежанка, яка працює в офісі.",
              "audio": "hr-les26-rule-02.mp3"
            },
            {
              "text": "Kuhar koji radi ovdje je vrlo dobar.",
              "ua": "Кухар, який тут працює, дуже добрий.",
              "audio": "hr-les26-rule-03.mp3"
            }
          ],
          "note_ua": "Тут допомагає українська: який, яка, яке працюють так само."
        }
      ],
      "points_ua": [
        "Koji: рід і число від іменника перед ним.",
        "Перед koji завжди кома.",
        "Тут допомагає українська."
      ]
    },
    {
      "title_ua": "Koji в інших відмінках",
      "summary_ua": "Рід і число koji беремо з іменника перед ним, а відмінок за роллю koji у підрядному реченні: чоловіка, якого я бачу: čovjek kojeg vidim (знахідний живого); директор, якому допомагаю: direktor kojem pomažem (давальний); учителька, з якою розмовляю: učiteljica s kojom razgovaram (орудний). Українське який і російське который працюють так само, тому тут допомагають обидві мови.",
      "compare": [
        {
          "form": "kojeg / koju (знахідний)",
          "when_ua": "Чоловічий живий kojeg, жіночий koju.",
          "examples": [
