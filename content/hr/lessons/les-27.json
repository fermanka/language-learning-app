  "rule": [
    {
      "title_ua": "Через: kroz, preko, zbog",
      "summary_ua": "Українське через має три хорватські відповідники. Kroz (+ знахідний) це «крізь»: kroz grad. Preko (+ родовий) це «через перешкоду»: preko mosta. Zbog (+ родовий) це причина: zbog posla. Російське через тут теж розпадається, тому допомагають обидві мови, але лише розпізнаванням: вибір слова треба вчити.",
      "compare": [
        {
          "form": "kroz + знахідний",
          "when_ua": "Рух всередині чогось: kroz grad.",
          "examples": [
            {
              "text": "Idem kroz grad.",
              "ua": "Іду через місто.",
              "audio": "hr-les27-rule-01.mp3"
            },
            {
              "text": "Avion leti preko grada.",
              "ua": "Літак летить над містом.",
              "audio": "hr-les27-rule-02.mp3"
            }
          ],
          "note_ua": "Kroz grad = всередині міста, preko grada = над містом чи поперек."
        },
        {
          "form": "preko + родовий",
          "when_ua": "Через перешкоду: preko mosta, preko ceste.",
          "examples": [
            {
              "text": "Idem preko mosta.",
              "ua": "Іду через міст.",
              "audio": "hr-les27-rule-03.mp3"
            },
            {
              "text": "Brod je pored mosta.",
              "ua": "Корабель біля мосту.",
              "audio": "hr-les27-rule-04.mp3"
            }
          ],
          "note_ua": "Тут допомагає українська: через міст = preko mosta."
        },
        {
          "form": "zbog + родовий",
          "when_ua": "Причина: zbog posla, zbog kiše.",
          "examples": [
            {
              "text": "Putujem zbog posla.",
              "ua": "Подорожую через роботу.",
              "audio": "hr-les27-rule-05.mp3"
            },
            {
              "text": "Ostajem kod kuće zbog kiše.",
              "ua": "Залишаюся вдома через дощ.",
              "audio": "hr-les27-rule-06.mp3"
            }
          ],
          "note_ua": "Це не jer: jer + речення, zbog + іменник у родовому."
        }
      ],
      "points_ua": [
        "Kroz + знахідний.",
        "Preko + родовий.",
        "Zbog + родовий (причина)."
      ]
    },
    {
      "title_ua": "Де саме: pored, ispred, iza, među",
      "summary_ua": "Pored (біля), ispred (перед), iza (за) і kod (біля, у) вимагають родового. Među вимагає орудного, коли йдеться про місце: među ljudima. Ispred про місце, а prije (Lekcija 21) про час.",
      "compare": [
        {
          "form": "pored / ispred / iza + родовий",
          "when_ua": "pored ceste, ispred hotela, iza kuće.",
          "examples": [
            {
              "text": "Hotel je pored ceste.",
              "ua": "Готель біля дороги.",
              "audio": "hr-les27-rule-07.mp3"
            },
            {
              "text": "Autobus je ispred hotela.",
              "ua": "Автобус перед готелем.",
              "audio": "hr-les27-rule-08.mp3"
            },
            {
              "text": "Auto je iza kuće.",
              "ua": "Машина за будинком.",
              "audio": "hr-les27-rule-09.mp3"
            }
          ],
          "note_ua": "В українській після біля, перед, за стоять різні відмінки (біля готелю, перед готелем, за будинком). У хорватській усі три з родовим, тож це треба вчити окремо."
        },
        {
          "form": "među + орудний",
          "when_ua": "Де? Među ljudima.",
          "examples": [
            {
              "text": "Među ljudima je puno putnika.",
              "ua": "Серед людей багато пасажирів.",
              "audio": "hr-les27-rule-10.mp3"
            },
            {
              "text": "Putnik čeka ispred hotela.",
              "ua": "Пасажир чекає перед готелем.",
              "audio": "hr-les27-rule-11.mp3"
            }
          ],
          "note_ua": "Ljudima це орудний множини (Lekcija 20)."
        }
      ],
      "points_ua": [
        "Pored, ispred, iza, kod: усі з родовим.",
        "Među: орудний (де?) або знахідний (куди?)."
      ]
    },
    {
      "title_ua": "K і kod: до кого, у кого",
      "summary_ua": "K + давальний це «до»: Idem k liječniku, k baki. Kod + родовий це «у, біля»: Čekam kod liječnika, kod bake, kod kuće. Це та сама пара, що gdje і kamo: kamo? k liječniku; gdje? kod liječnika. В українській обидва «до» і «у» часто не різняться так чітко.",
      "compare": [
        {
          "form": "k + давальний (куди?)",
          "when_ua": "Рух до особи: k liječniku, k baki.",
          "examples": [
