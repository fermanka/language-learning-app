  "rule": [
    {
      "title_ua": "Netko, nešto, nitko, ništa",
      "summary_ua": "Ne- значить «якийсь»: netko (хтось), nešto (щось). Ni- значить «жоден»: nitko (ніхто), ništa (нічого). Подвійне заперечення обов'язкове, як в українській і російській: Nitko ne radi. Ništa ne jedem. Це безкоштовний виграш, на відміну від англійської.",
      "compare": [
        {
          "form": "netko, nešto",
          "when_ua": "Хтось і щось: стверджувальне речення.",
          "examples": [
            {
              "text": "Netko je ovdje.",
              "ua": "Хтось тут.",
              "audio": "hr-les29-rule-01.mp3"
            },
            {
              "text": "Imam nešto ukusno.",
              "ua": "Маю щось смачне.",
              "audio": "hr-les29-rule-02.mp3"
            },
            {
              "text": "Vidim nekoga tamo.",
              "ua": "Бачу когось там.",
              "audio": "hr-les29-rule-03.mp3"
            }
          ],
          "note_ua": "Тут допомагає українська: хтось, щось, але закінчення свої."
        },
        {
          "form": "nitko, ništa + ne",
          "when_ua": "Подвійне заперечення: nitko ne, ništa ne, ne ... nikoga.",
          "examples": [
            {
              "text": "Nitko ne radi.",
              "ua": "Ніхто не працює.",
              "audio": "hr-les29-rule-04.mp3"
            },
            {
              "text": "Ništa ne jedem.",
              "ua": "Нічого не їм.",
              "audio": "hr-les29-rule-05.mp3"
            },
            {
              "text": "Ne vidim nikoga.",
              "ua": "Не бачу нікого.",
              "audio": "hr-les29-rule-06.mp3"
            }
          ],
          "note_ua": "Тут допомагають обидві мови: нікого не бачу, ничего не вижу. Не пиши Nitko radi."
        }
      ],
      "points_ua": [
