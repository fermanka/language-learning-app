  "rule": [
    {
      "title_ua": "Htjeti: хочу, хочеш",
      "summary_ua": "Hoću, hoćeš, hoće, hoćemo, hoćete, hoće. Тут українська допомагає: хочу = hoću. Після htjeti стоїть інфінітив (Hoću ići) або da + теперішній (Hoću da idem, Lekcija 21). Питання: Hoćeš li ići? Заперечення: neću (Lekcija 12). Клітик ću теж від htjeti, але це інше слово: Ići ću.",
      "compare": [
        {
          "form": "hoću, hoćeš, hoće + інфінітив",
          "when_ua": "Повне дієслово «хочу».",
          "examples": [
            {
              "text": "Hoću ići u kino.",
              "ua": "Хочу піти в кіно.",
              "audio": "hr-les30-rule-01.mp3"
            },
            {
              "text": "Ivan hoće igrati squash.",
              "ua": "Іван хоче грати в сквош.",
              "audio": "hr-les30-rule-02.mp3"
            },
            {
              "text": "Hoćemo ići na koncert u petak.",
              "ua": "Хочемо піти на концерт у п'ятницю.",
              "audio": "hr-les30-rule-03.mp3"
            }
          ],
          "note_ua": "Тут допомагає українська: хочу, хоче, хочемо."
        },
        {
          "form": "питання і заперечення",
          "when_ua": "Hoćeš li ...? Neću, nećemo.",
          "examples": [
            {
              "text": "Hoćeš li ići na bazen?",
              "ua": "Хочеш піти на басейн?",
              "audio": "hr-les30-rule-04.mp3"
            },
            {
              "text": "Nećemo ići na plažu.",
              "ua": "Ми не підемо на пляж.",
              "audio": "hr-les30-rule-05.mp3"
            },
            {
              "text": "Neću ići u teretanu.",
              "ua": "Не хочу йти в тренажерний зал.",
              "audio": "hr-les30-rule-06.mp3"
            }
          ],
          "note_ua": "Neću може бути й «не буду», й «не хочу»: з контексту."
        }
      ],
      "points_ua": [
        "Hoću, hoćeš, hoće, hoćemo, hoćete, hoće.",
        "Hoćeš li ...? Neću.",
        "Hoću (повне) проти ću (клітик, не перший)."
      ]
    },
