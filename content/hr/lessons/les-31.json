  "rule": [
    {
      "title_ua": "Непряма мова: Učiteljica govori da...",
      "summary_ua": "Непряма мова з da: Učiteljica govori da je test težak. Час такий самий, як у прямій мові: Test je težak > govori da je test težak; Test je težak > rekla je da je test težak. Українська і російська роблять так само, тож це безкоштовний виграш, на відміну від англійської.",
      "compare": [
        {
          "form": "govori / je rekla + da + речення",
          "when_ua": "Час той самий, що в прямій мові.",
          "examples": [
            {
              "text": "Učiteljica govori da je test težak.",
              "ua": "Вчителька каже, що тест важкий.",
              "audio": "hr-les31-rule-01.mp3"
            },
            {
              "text": "Učiteljica je rekla da je zadatak važan.",
              "ua": "Вчителька сказала, що завдання важливе.",
              "audio": "hr-les31-rule-02.mp3"
            },
            {
              "text": "Ivan je rekao da radi zadaću.",
              "ua": "Іван сказав, що робить домашнє.",
              "audio": "hr-les31-rule-03.mp3"
            }
          ],
          "note_ua": "Тут допомагає українська: сказав, що працює = rekao je da radi."
        },
        {
          "form": "питання й прохання в непрямій мові",
          "when_ua": "Питання: Pitala me je radim li zadaću. Прохання: da + теперішній (Lekcija 21).",
          "examples": [
            {
              "text": "Pitala me je radim li zadaću.",
              "ua": "Вона спитала мене, чи роблю я домашнє.",
              "audio": "hr-les31-rule-04.mp3"
            },
            {
              "text": "Rekla mi je da ponavljam zadatak.",
              "ua": "Вона сказала мені, щоб я повторювала завдання.",
              "audio": "hr-les31-rule-05.mp3"
            },
            {
              "text": "Rekla sam mu da je test težak.",
              "ua": "Я сказала йому, що тест важкий.",
              "audio": "hr-les31-rule-06.mp3"
            }
          ],
          "note_ua": "Пастка: українське «щоб + минулий» (щоб повторювала), а після da теперішній: da ponavljam. Питання «чи» це li: radim li."
        }
      ],
      "points_ua": [
        "Час як у прямій мові: govori da je, rekla je da je.",
        "Прохання: da + теперішній (da ponavljam).",
        "Питання: li на другому місці (radim li)."
      ]
    },
    {
      "title_ua": "Порядок клітиків: що я підтверджую",
      "summary_ua": "Клітики стоять разом на другому місці у фіксованому порядку: li, потім допоміжне (sam, si, smo, ste, su, bih, ću...), потім давальний (mi, mu, joj...), потім знахідний (me, te, ga...), потім se, і в самому кінці je (3 особа). Rekla mi je (давальний + je). Rekla sam mu (sam + давальний). Pitala me je (знахідний + je). Javila sam se (sam + se). Ні українська, ні російська не мають такого жорсткого порядку: тут нічого не переноситься.",
      "compare": [
        {
          "form": "допоміжне + давальний / давальний + je",
          "when_ua": "sam mu, mi je, me je.",
          "examples": [
            {
              "text": "Rekla sam mu da je test težak.",
              "ua": "Я сказала йому, що тест важкий.",
              "audio": "hr-les31-rule-07.mp3"
            },
            {
              "text": "Rekla mi je da ponavljam zadatak.",
              "ua": "Вона сказала мені повторювати завдання.",
              "audio": "hr-les31-rule-08.mp3"
            },
            {
              "text": "Pitala me je radim li zadaću.",
              "ua": "Вона спитала мене, чи роблю я домашнє.",
              "audio": "hr-les31-rule-09.mp3"
            }
          ],
          "note_ua": "Je (3 особа) завжди найостанніший: mi je, me je, а не je mi."
        },
        {
          "form": "se",
          "when_ua": "sam se (1 особа); 3 особа без je: Učiteljica se javila.",
          "examples": [
