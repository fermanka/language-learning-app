  "rule": [
    {
      "title_ua": "Biti + trpni pridjev: rezultat radnje",
      "summary_ua": "Trpni pridjev (na -n ili -t) pokazuje stanje nakon radnje: most je izgrađen, vrata su zatvorena. Slaže se u rodu i broju s imenicom. Vrijeme pokazuje pomoćni glagol: je, bio je, bit će. UA: біти + пасивний дієприкметник = результат; узгоджується за родом і числом.",
      "compare": [
        {
          "form": "je / su + particip",
          "when_ua": "Radnja je gotova.",
          "examples": [
            {
              "text": "Kuća je izgrađena prije deset godina.",
              "ua": "Будинок збудований десять років тому.",
              "audio": "hr-les62-rule-01.mp3"
            },
            {
              "text": "Obrazac je već bio ispunjen.",
              "ua": "Бланк уже був заповнений.",
              "audio": "hr-les62-rule-02.mp3"
            }
          ],
          "note_ua": "Kuća (ž.) = izgrađena; obrazac (m.) = ispunjen. Bio je već: klitik je odmah poslije bio."
        },
        {
          "form": "bit će + particip",
          "when_ua": "Budućnost.",
          "examples": [
