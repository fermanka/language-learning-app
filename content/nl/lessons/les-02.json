  "rule": {
    "title_ua": "Заперечення: geen чи niet",
    "summary_ua": "Коли ми хочемо сказати «не» або «немає», вибираємо geen або niet залежно від того, що саме заперечуємо.",
    "see": "Les 1",
    "compare": [
      {
        "form": "geen",
        "when_ua": "іменник неозначений: з een, у множині або речовина без артикля. Geen стоїть замість een або замість відсутнього артикля.",
        "examples": [
