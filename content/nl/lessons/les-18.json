  "rule": [
    {
      "title_ua": "Komen: kom, а не koom",
      "summary_ua": "Komen значить «приходити», а komen uit + країна значить «бути родом з». Основа пишеться kom з однією m і без подвоєння o, хоч в інфінітиві o довга.",
      "see": "Les 7",
      "compare": [
        {
          "form": "Kom, komt, komen",
          "when_ua": "Ik kom, jij komt, hij komt, wij komen. Голосна o одна: kom, а не koom.",
          "examples": [
            {
              "nl": "Ik **kom** uit Nederland.",
              "ua": "Я родом з Нідерландів.",
              "audio": "les18-example-03.mp3"
            },
            {
              "nl": "Zij **komt** uit Kroatië.",
              "ua": "Вона родом з Хорватії.",
              "audio": "les18-rule-01.mp3"
            },
            {
              "nl": "Wij **komen** uit Kroatië.",
              "ua": "Ми родом з Хорватії.",
              "audio": "les18-example-05.mp3"
