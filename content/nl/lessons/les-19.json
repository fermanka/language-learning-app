  "rule": [
    {
      "title_ua": "Ik vind het huis mooi: прикметник в кінці",
      "summary_ua": "Vinden + що оцінюємо + прикметник в кінці: Ik vind het huis mooi. Прикметник тут стоїть без закінчення, відмінків немає. Українське «вважаю дім гарним» (орудний відмінок) нідерландською просто mooi.",
      "see": "Les 11",
      "compare": [
        {
          "form": "Vinden + іменник + прикметник",
          "when_ua": "Порядок: підмет, vind(t), що оцінюємо, прикметник. Прикметник без -e і без змін.",
          "examples": [
            {
              "nl": "Ik **vind** het huis mooi.",
              "ua": "Я вважаю дім гарним.",
              "audio": "les19-example-01.mp3"
            },
            {
              "nl": "Zij **vindt** de school groot.",
              "ua": "Вона вважає школу великою.",
              "audio": "les19-rule-01.mp3"
            },
            {
              "nl": "Wij **vinden** de koffie lekker.",
              "ua": "Ми вважаємо каву смачною.",
              "audio": "les19-rule-02.mp3"
            }
          ],
          "note_ua": "Не Ik vind het huis mooie: у кінці речення -e немає."
        },
        {
          "form": "Hoe vind je ...?",
          "when_ua": "Питання «як тобі ...?»: Hoe, потім vind, потім підмет, потім що оцінюємо. Після jij t зникає.",
          "examples": [
            {
              "nl": "Hoe **vind** je het café?",
              "ua": "Як тобі кафе?",
              "audio": "les19-rule-03.mp3"
            },
            {
              "nl": "Hoe **vindt** hij de stad?",
              "ua": "Як йому місто?",
              "audio": "les19-rule-04.mp3"
            }
          ],
          "note_ua": "Vind jij, а не vindt jij, як heet jij (Les 18)."
        }
      ],
      "points_ua": [
        "Ik vind, hij vindt, wij vinden. Після jij у питанні: vind jij.",
        "Прикметник в кінці без -e: Ik vind het huis mooi."
      ]
    },
