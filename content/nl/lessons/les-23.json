  "rule": [
    {
      "title_ua": "Het regent: het без предмета",
      "summary_ua": "Про погоду дієслово потребує het: Het regent. Українською можна «Іде дощ» без підмета, нідерландською підмет обов'язковий. Це не артикль, а «воно».",
      "see": "Les 13",
      "compare": [
        {
          "form": "Het + regent, sneeuwt, waait",
          "when_ua": "Дощ, сніг, вітер: підмет завжди het. Про дощ чи сніг ти не питаєш «хто?»: воно просто йде.",
          "examples": [
            {
              "nl": "**Het** regent niet.",
              "ua": "Дощ не йде.",
              "audio": "les23-rule-01.mp3"
            },
            {
              "nl": "**Het** sneeuwt soms.",
              "ua": "Іноді йде сніг.",
              "audio": "les23-rule-02.mp3"
            },
            {
              "nl": "**Het** waait vandaag.",
              "ua": "Сьогодні віє вітер.",
              "audio": "les23-rule-03.mp3"
            },
            {
