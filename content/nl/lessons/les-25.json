  "rule": [
    {
      "title_ua": "Een kilo appels, een fles water: без van",
      "summary_ua": "Мірне слово (kilo, fles, stuk) і те, що міряємо, стоять поруч. Без прийменника і без артикля: een kilo appels, een fles water, een stuk kaas. Українською друге слово в родовому відмінку («пляшка води»), нідерландською відмінків немає.",
      "see": "Les 12",
      "compare": [
        {
          "form": "Een kilo / een fles / een stuk + що міряємо",
          "when_ua": "Мірне слово, потім одразу продукт. Не ставимо van і не ставимо de / het перед продуктом.",
          "examples": [
            {
              "nl": "Ik koop **een kilo** appels.",
              "ua": "Я купую кілограм яблук.",
              "audio": "les25-rule-01.mp3"
            },
            {
              "nl": "Hij koopt **een fles** wijn.",
              "ua": "Він купує пляшку вина.",
              "audio": "les25-rule-02.mp3"
            },
            {
              "nl": "Zij eet **een stuk** brood.",
              "ua": "Вона їсть шматок хліба.",
              "audio": "les25-rule-03.mp3"
